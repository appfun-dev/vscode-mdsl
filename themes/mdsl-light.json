{
  "$schema": "vscode://schemas/color-theme",
  "name": "MDSL Light (Default)",
  "type": "light",
  "colors": {
    "focusBorder": "#0066b8",
    "foreground": "#1f1f1f",
    "descriptionForeground": "#7a7a7a",
    "errorForeground": "#cd3131",
    "textLink.foreground": "#0066b8",
    "textLink.activeForeground": "#00519a",
    "textPreformat.foreground": "#a31515",
    "textBlockQuote.background": "#f3f3f3",
    "selection.background": "#add6ff",
    "scrollbarSlider.background": "#7a7a7a47",
    "scrollbarSlider.hoverBackground": "#7a7a7a66",
    "scrollbarSlider.activeBackground": "#7a7a7a8c",
    "widget.shadow": "#00000029",
    "editor.background": "#ffffff",
    "editor.foreground": "#1f1f1f",
    "editorLineNumber.foreground": "#7a7a7a",
    "editorLineNumber.activeForeground": "#000000",
    "editorCursor.foreground": "#000000",
    "editor.selectionBackground": "#add6ff",
    "editor.inactiveSelectionBackground": "#e5ebf1",
    "editor.lineHighlightBackground": "#f5f5f5",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#d4d4d4",
    "editorIndentGuide.background1": "#d4d4d4",
    "editorIndentGuide.activeBackground1": "#7a7a7a",
    "editorBracketMatch.background": "#e5ebf1",
    "editorBracketMatch.border": "#0066b8",
    "editorGutter.background": "#ffffff",
    "editorError.foreground": "#cd3131",
    "editorWarning.foreground": "#895503",
    "editorInfo.foreground": "#1a85ff",
    "editorHoverWidget.background": "#f3f3f3",
    "editorHoverWidget.border": "#d4d4d4",
    "editorHoverWidget.foreground": "#1f1f1f",
    "editorSuggestWidget.background": "#f3f3f3",
    "editorSuggestWidget.border": "#d4d4d4",
    "editorSuggestWidget.foreground": "#1f1f1f",
    "editorSuggestWidget.selectedBackground": "#add6ff",
    "editorSuggestWidget.highlightForeground": "#0066b8",
    "editorWidget.background": "#f3f3f3",
    "editorWidget.border": "#d4d4d4",
    "editorWidget.foreground": "#1f1f1f",
    "editorGroup.border": "#d4d4d4",
    "editorGroupHeader.tabsBackground": "#f3f3f3",
    "editorInlayHint.background": "#f3f3f3",
    "editorInlayHint.foreground": "#7a7a7a",
    "editorMarkerNavigationError.background": "#cd3131",
    "editorMarkerNavigationWarning.background": "#895503",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f3f3f3",
    "tab.activeForeground": "#000000",
    "tab.inactiveForeground": "#7a7a7a",
    "tab.border": "#d4d4d4",
    "tab.activeBorderTop": "#0066b8",
    "tab.hoverBackground": "#e8e8e8",
    "sideBar.background": "#f3f3f3",
    "sideBar.foreground": "#1f1f1f",
    "sideBar.border": "#d4d4d4",
    "sideBarTitle.foreground": "#1f1f1f",
    "sideBarSectionHeader.background": "#ffffff",
    "sideBarSectionHeader.foreground": "#1f1f1f",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#7a7a7a",
    "activityBar.border": "#d4d4d4",
    "activityBarBadge.background": "#0066b8",
    "activityBarBadge.foreground": "#ffffff",
    "statusBar.background": "#0066b8",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#d4d4d4",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#895503",
    "statusBar.debuggingForeground": "#000000",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#1f1f1f",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#7a7a7a",
    "titleBar.border": "#d4d4d4",
    "list.activeSelectionBackground": "#add6ff",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#e5ebf1",
    "list.hoverBackground": "#e8e8e8",
    "list.focusBackground": "#add6ff",
    "list.highlightForeground": "#0066b8",
    "list.border": "#d4d4d4",
    "tree.indentGuidesStroke": "#d4d4d4",
    "input.background": "#ffffff",
    "input.foreground": "#1f1f1f",
    "input.border": "#d4d4d4",
    "input.placeholderForeground": "#7a7a7a",
    "inputOption.activeBorder": "#0066b8",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#1f1f1f",
    "dropdown.border": "#d4d4d4",
    "button.background": "#0066b8",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#00519a",
    "button.secondaryBackground": "#e8e8e8",
    "button.secondaryForeground": "#1f1f1f",
    "badge.background": "#0066b8",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#0066b8",
    "panel.background": "#ffffff",
    "panel.border": "#d4d4d4",
    "panelTitle.activeForeground": "#000000",
    "panelTitle.activeBorder": "#0066b8",
    "panelTitle.inactiveForeground": "#7a7a7a",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#1f1f1f",
    "breadcrumb.foreground": "#7a7a7a",
    "breadcrumb.focusForeground": "#1f1f1f",
    "breadcrumb.activeSelectionForeground": "#000000",
    "breadcrumbPicker.background": "#f3f3f3",
    "notifications.background": "#f3f3f3",
    "notifications.foreground": "#1f1f1f",
    "notifications.border": "#d4d4d4",
    "notificationCenterHeader.background": "#ffffff",
    "quickInput.background": "#f3f3f3",
    "quickInput.foreground": "#1f1f1f",
    "quickInputList.focusBackground": "#add6ff",
    "menu.background": "#f3f3f3",
    "menu.foreground": "#1f1f1f",
    "menu.selectionBackground": "#add6ff",
    "menu.border": "#d4d4d4",
    "menubar.selectionBackground": "#e8e8e8",
    "keybindingLabel.background": "#e8e8e8",
    "keybindingLabel.foreground": "#1f1f1f",
    "keybindingLabel.border": "#d4d4d4",
    "gitDecoration.modifiedResourceForeground": "#895503",
    "gitDecoration.deletedResourceForeground": "#cd3131",
    "gitDecoration.untrackedResourceForeground": "#107c10",
    "gitDecoration.ignoredResourceForeground": "#7a7a7a",
    "gitDecoration.conflictingResourceForeground": "#895503",
    "diffEditor.insertedTextBackground": "#107c102e",
    "diffEditor.removedTextBackground": "#cd31312e",
    "minimap.background": "#ffffff",
    "minimapSlider.background": "#7a7a7a33"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#0070c1"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#0000ff"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0000ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#267f99"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#795e26"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#383838"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e50000"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#811f3f"
      }
    },
    {
      "scope": [
        "storage.type.annotation",
        "meta.declaration.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#808000"
      }
    },
    {
      "scope": [
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#cd3131"
      }
    },
    {
      "scope": [
        "keyword.control.mdsl"
      ],
      "settings": {
        "foreground": "#af00db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.other.mdsl"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "storage.type.mdsl"
      ],
      "settings": {
        "foreground": "#0000ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.constant.role.mdsl"
      ],
      "settings": {
        "foreground": "#267f99"
      }
    },
    {
      "scope": [
        "support.constant.responsibility.mdsl"
      ],
      "settings": {
        "foreground": "#795e26"
      }
    },
    {
      "scope": [
        "constant.language.http-method.mdsl"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "scope": [
        "constant.language.parameter-location.mdsl"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "scope": [
        "constant.language.protocol.mdsl"
      ],
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "scope": [
        "constant.language.security.mdsl"
      ],
      "settings": {
        "foreground": "#cd3131"
      }
    },
    {
      "scope": [
        "constant.language.enumeration.mdsl"
      ],
      "settings": {
        "foreground": "#0070c1"
      }
    },
    {
      "scope": [
        "storage.type.element-role.mdsl"
      ],
      "settings": {
        "foreground": "#267f99"
      }
    },
    {
      "scope": [
        "support.type.primitive.mdsl"
      ],
      "settings": {
        "foreground": "#0000ff"
      }
    },
    {
      "scope": [
        "storage.type.stereotype.mdsl"
      ],
      "settings": {
        "foreground": "#795e26",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type.mdsl"
      ],
      "settings": {
        "foreground": "#267f99"
      }
    },
    {
      "scope": [
        "entity.name.type.reference.mdsl"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "entity.name.function.mdsl"
      ],
      "settings": {
        "foreground": "#795e26"
      }
    },
    {
      "scope": [
        "variable.other.property.mdsl"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "keyword.operator.quantifier.mdsl"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "keyword.operator.choice.mdsl"
      ],
      "settings": {
        "foreground": "#000000"
      }
    }
  ]
}
