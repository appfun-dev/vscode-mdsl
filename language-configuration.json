{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    ["<", ">"],
    ["<<", ">>"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["<", ">"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*(//\\s*#?region|/\\*)",
      "end": "^\\s*(//\\s*#?endregion|\\*/)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*(?:\\{[^}\"']*|\\b(?:exposes|expecting|delivering|reporting|offers|binding|payload|headers|consumes|objective)\\s*)$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_\\-]*",
  "onEnterRules": [
    {
      "beforeText": "^.+\\{\\s*$",
      "afterText": "^\\s*\\}.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.+\\{\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*/\\*\\s*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": {
        "indent": "indentOutdent",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "action": {
        "indent": "none",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^(\\t|[ ])*[ ]\\*.*$",
      "action": {
        "indent": "none",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^(\\t|[ ])*[ ]\\*/\\s*$",
      "action": {
        "indent": "none",
        "removeText": 1
      }
    }
  ]
}
